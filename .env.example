# =========================================================================
# SchemaForge Data-OS: Environment Variables & Cloud Configuration Template
# =========================================================================

# Google Cloud Platform Identity & Region
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# BigQuery Gold Analytics Warehouse
BQ_DATASET_GOLD=gold_analytics

# Google Gemini / Vertex AI Configuration
# Note: On Google Cloud Run, authentication is automatically handled via Application Default Credentials (ADC)
# or Service Account IAM roles (roles/aiplatform.user, roles/bigquery.dataEditor, roles/pubsub.publisher).
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.2

# Application Server Settings
PORT=8080
ENV=production
LOG_LEVEL=INFO
